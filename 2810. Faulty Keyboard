class Solution {
public:
    string finalString(string s) {
        int i=0; 
        string t;
        while(i<s.size()){
            if(s[i] != 'i'){
                t.push_back(s[i]);
                i++;
            }
            if(s[i] == 'i'){
                reverse(t.begin(),t.end());
                i++;
            }
        }
        return t;
    }
};
