class Solution {
public:
    int missingNumber(vector<int>& nums) {
        sort(nums.begin(), nums.end()); //first sort the array
        int value = 0; //value to compare the array
        for(int i=0; i<nums.size(); i++) {
            if(nums[i] == value ){
                value++;
            }
            else{
                return value;
            }
            
        }
        return value;
    }
};

//Sum approach
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int sum = 0;
        int n = nums.size();
        int totalSum = n * (n+1) /2;

        for(int num : nums){
            sum = sum+num;
        }
        return totalSum-sum;
    }
};

//XOR approach
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int xor1 = 0, xor2 = 0;

        for(int num:nums){
            xor1 = xor1 ^ num;
        }

        for(int i=0;i<=nums.size();i++){
            xor2 = xor2 ^ i;
        }
        return xor1 ^ xor2;
    }
};
