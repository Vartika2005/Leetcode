//optimal approach
class Solution {
public:
    vector<int> corpFlightBookings(vector<vector<int>>& bookings, int n) {
        vector<int> diff(n+1,0);

        for(int i=0;i<bookings.size();i++){
            int start = bookings[i][0];
            int end = bookings[i][1];
            int seats = bookings[i][2];

            diff[start - 1] += seats;
            diff[end] -= seats;
        }

        vector<int> ans(n);
        int sum  = 0;

        for(int i=0;i<n;i++){
            sum += diff[i];
            ans[i] = sum;
        }
        return ans;
    }
};


//brute force
class Solution {
public:
    vector<int> corpFlightBookings(vector<vector<int>>& bookings, int n) {
        vector<int> ans(n,0);
        for(int i=0;i<bookings.size();i++) {
            int start = bookings[i][0];
            int end = bookings[i][1];
            int seats = bookings[i][2];

            for(int j=start; j<=end; j++){
                ans[j-1] += seats;
            }
        }
        return ans;
    }
};
