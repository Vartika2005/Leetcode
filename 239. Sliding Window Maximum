class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        deque<int> dq;
        vector<int> ans;

        int n = nums.size();

        for(int i=0;i<n;i++){
            //out of window element remove
            if(!dq.empty() && dq.front() <= i-k) {
                dq.pop_front();
            }
            //smaller element remove
            while(!dq.empty() && nums[dq.back()] < nums[i]) {
                dq.pop_back();
            }
            //push current index
            dq.push_back(i);

            //ans store
            if(i >= k-1){
                ans.push_back(nums[dq.front()]);
            }
        }
        return ans;
        
    }
};
