//using reverse function
class Solution {
public:
    string reversePrefix(string s, int k) {
        if(k <= 1){
            return s;
        }
            
        reverse(s.begin(),s.begin() + k );
        return s;
    }

};

//from sratch
class Solution {
public:
    string reversePrefix(string s, int k) {
        int left = 0;
        int right = k-1;

        while(left < right) {
            swap(s[left],s[right]);
            left++;
            right--;
        }
        return s;
    }
};
