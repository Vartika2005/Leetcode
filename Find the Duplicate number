//by using unordered set
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        unordered_set<int> s;
        int ans;
        for(int num : nums) {
            if(s.count(num))
             return num;
            s.insert(num);
        }
        return -1;
    }
};

//By using unordered map
class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        unordered_map<int,int> mp;

        for(int i=0;i<nums.size();i++){
            int x = nums[i];
            mp[x]++;
        }
        for(auto x : mp) {
            if(x.second > 1) return x.first;
        }
        return -1;
    }
};
