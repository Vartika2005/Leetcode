class Solution {
public:
    bool isAnagram(string s, string t) {
        int freqTable[256] = {0};
        for(int i=0; i<s.size(); i++){
            freqTable[s[i]]++;  //just like has table
        }

        for(int i=0;i<t.size();i++){
            freqTable[t[i]]--;
        }

        for(int i=0; i<256;i++){
            if(freqTable[i] != 0){
                return false;
            }
        }
        return true;
    }
};

//another approach 
class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.length() != t.length()) return false;
        unordered_map<char,int> mp;
        for(auto x : s){
            mp[x]++;
        }
        for(char c : t) {
            mp[c]--;
            if(mp[c] < 0){
                return false;
            }
        }
        return true;;
    }
};
