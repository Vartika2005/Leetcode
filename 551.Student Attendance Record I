class Solution {
public:
    bool checkRecord(string s) {
        int const_late = 0;
        int absent = 0;
        for(int i=0;i<s.length();i++){
            if(s[i] == 'P'){
                const_late = 0;
            }
            if(s[i] == 'A'){
                const_late = 0;
                absent++;
                if(absent >= 2){
                    return false;
                    break;
                }
            }
            if(s[i] == 'L'){
                const_late++;
                if(const_late >= 3){
                    return false;
                    break;
                }
            }
        }
        return true;
    }
};
