class Solution {
public:
    string addBinary(string a, string b) {
        string ans;
        int i = a.size()-1, j = b.size()-1;
        for(int carry = 0; i>=0 || j>=0 || carry; i--, j--){
            if(i>=0) {
                carry += a[i]-'0';
            }
            else{
                carry += 0;
            }

            if(j>=0){
                carry += b[j] -'0';
            }
            else{
                carry += 0;
            }
            ans.push_back((carry%2) + '0');
            carry /= 2;
        }
        reverse(ans.begin(),ans.end());
        return ans;
    }
};
