//optimal approach
class Solution {
public:
    bool carPooling(vector<vector<int>>& trips, int capacity) {
        map<int,int> mp;

        for(int i=0;i<trips.size();i++){
            int passengers = trips[i][0];
            int from = trips[i][1];
            int to = trips[i][2];

            mp[from] += passengers;
            mp[to] -= passengers;
        }
        int curr = 0;
        
        for(auto x : mp){
            curr += x.second;
            if(curr > capacity) return false;
        }
        return true;

    }
};
