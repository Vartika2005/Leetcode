class Solution {
public:
    string reverseWords(string s) {
        int n = s.length();
        vector<string> temp;
        string word = "";
        int i = 0;
        while(i<n){
            if(s[i] != ' '){
                word.push_back(s[i]);
                i++;
            }
            else{
                if(!word.empty()){
                    temp.push_back(word);
                    word = "";
                }
                i++;
            }
        }
        if(!word.empty()) {
            temp.push_back(word);
        }
        string ans = "";
        for(int i = temp.size()-1; i>=0;i--){
            ans += temp[i];
            if(i != 0){
                ans += " ";
            }
        }
        return ans;
    }
};
