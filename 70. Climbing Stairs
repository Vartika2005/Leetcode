class Solution {
public:
    int rec(int n, vector<int>& dp){
        //base case
        if(n == 0) return 1;
        if(n < 0) return 0;

        //check dp
        if(dp[n] != -1){
            return dp[n];
        }

        //recursion + store
        return dp[n] = rec(n-1,dp) + rec(n-2,dp);

    }
    int climbStairs(int n) {
        vector<int> dp(n+1, -1);
        return rec(n, dp);
    }
};
