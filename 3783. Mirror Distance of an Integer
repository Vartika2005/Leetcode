//using math
class Solution {
public:
    int mirrorDistance(int n) {
        int rev = 0;
        int temp= n;

        while(temp > 0){
            rev = rev* 10 + temp % 10;
            temp /= 10;
        }

        return abs(rev - n);
        
    }
};

//using conversion function
class Solution {
public:
    int mirrorDistance(int n) {
        string s = to_string(n);
        reverse(s.begin(),s.end());
        int val = stoi(s);
        int ans = abs(val - n);
        return ans;
    }
};
