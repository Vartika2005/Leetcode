class Solution {
public:
    vector<int> applyOperations(vector<int>& nums) {
        vector<int> ans;
        for(int i=0;i<nums.size()-1;i++){
            if(nums[i] != nums[i+1]) {
                continue;
            }
            else{
                nums[i] = nums[i]*2;
                nums[i+1] = 0;
            }
        }
        for(int i=0;i<nums.size();i++) {
            ans.push_back(nums[i]);
        }

        int i=0;
        for(int j=0;j<nums.size();j++){
            if(nums[j] != 0){
                swap(nums[i],nums[j]);
                i++;
            }
        }
        return nums;
        
    }
};
