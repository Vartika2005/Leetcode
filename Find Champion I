//here we count loss whoever have 0 loses is the winner 
class Solution {
public:
    int findChampion(vector<vector<int>>& grid) {
        int n = grid.size();
        for(int j=0;j<grid.size();j++){
            int loss = 0;
            for(int i=0;i<grid.size();i++){
                if(i != j && grid[i][j] == 1) {
                    loss++;
                }
            }
            if(loss == 0) return j;
        }
        return -1;
    }
};
