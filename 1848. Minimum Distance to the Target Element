class Solution {
public:
    int getMinDistance(vector<int>& nums, int target, int start) {
        int ans = INT_MAX;
        for(int i=0;i<nums.size();i++){
            int result = abs(i-start);
            if((nums[i] == target) && (result < ans)) {
                ans = result;
            }
        }
        return ans;
    }
};
