class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
       int i = 0;
       for(int i=0; i<nums.size(); i++) {
        for(int j=i+1; j<nums.size(); j++){
            if(nums[i] + nums[j] == target ){
                return {i,j};
            }
        }
    } 
        return {}; // if no solution found
    }
};

//optimise 
class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        unordered_map<int,int> mp;
        for(int i=0;i<nums.size();i++){
            int req = target-nums[i];
            if(mp.count(req)){
                return {mp[req],i};
            }
            mp[nums[i]] = i;
        }
        
    }
};
