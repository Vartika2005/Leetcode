class Solution {
public:
    bool checkString(string s) {
        bool found = 0;
        for(int i=0;i<s.length();i++){
            if(s[i] == 'b'){
                found = 1;
            }
            if(s[i]=='a' && found == 1){
                return false;
            }
        }
        return true;
    }
};
