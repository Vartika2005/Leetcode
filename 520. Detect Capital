class Solution {
public:
    bool detectCapitalUse(string word) {
        int n = word.length();
        int uppercount = 0;
        for(auto x : word){
            if(isupper(x) ){
                uppercount++;
            }
        }
        if(uppercount == n || uppercount == 0 ||  ((uppercount == 1)  && isupper(word[0])))return true;

        return false;

    }
};
